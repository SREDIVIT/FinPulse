# ===================================================================
# FinPulse / FinTrack Root Environment Template
# Copy this file to .env and fill in your values
# ===================================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# For Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/fintrack

# For MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fintrack?retryWrites=true&w=majority

# Supported alternate variable names:
# MONGODB_URI=
# DATABASE_URL=

JWT_SECRET=your_jwt_secret_key_here

# Email Delivery Configuration (Optional):
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
